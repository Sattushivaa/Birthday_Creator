# MongoDB connection string (Atlas, or any mongod). Required.
# Local: copy to .env. Production: set these in Vercel project settings.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.mongodb.net/?appName=Cluster0
# Optional: pick the database name (default "birthday")
MONGODB_DB=birthday

# Optional: override the creator password hash. Default is the bcrypt hash of
# "birthday" — change it from the creator dashboard (Settings → Security)!
# ADMIN_PASSWORD_HASH=$2a$10$...

# Local dev port (default 3001)
PORT=3001